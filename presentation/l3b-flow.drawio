        <mxCell id="p2-31" value="ENTITY_&lt;br&gt;RESOLVED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="p2-18" target="p2-19"><mxGeometry relative="1" as="geometry" /></mxCell>
