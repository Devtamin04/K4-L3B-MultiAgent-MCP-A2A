        <mxCell id="p3-1" value="Ví dụ thật: L3B_CASE_010 — khách khiếu nại giao trễ do seller" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1820" height="50" as="geometry" /></mxCell>
        <mxCell id="p3-2" value="Case có candidate giả, và cùng một order_id có 2 lần mua — nguồn get_order trỏ nhầm sang lần mua khác" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="1820" height="34" as="geometry" /></mxCell>
        <mxCell id="p3-3" value="&lt;b&gt;① Input&lt;/b&gt;&lt;br&gt;Claims: &lt;b&gt;late_delivery_seller&lt;/b&gt; + requested_full_refund&lt;br&gt;Claimed order: 64a8b3b4…fdc67b&lt;br&gt;Candidates: [64a8b3b4…, &lt;b&gt;candidate-010&lt;/b&gt;]&lt;br&gt;opened_at: &lt;b&gt;2018-01-10&lt;/b&gt; · policy EC_POLICY_V2&lt;br&gt;Message: &lt;i&gt;“Có thể tồn tại claim mâu thuẫn hoặc candidate sai…”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="580" height="230" as="geometry" /></mxCell>
        <mxCell id="p3-4" value="&lt;b&gt;② Entity agent&lt;/b&gt;&lt;br&gt;get_customer_history → khách có 2 bản ghi của order này&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;✘ candidate-010&lt;/font&gt;: sai định dạng order_id (không phải 32-hex)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✔ 64a8b3b4…&lt;/font&gt;: có trong lịch sử khách&lt;br&gt;⇒ &lt;b&gt;ENTITY_RESOLVED&lt;/b&gt; (confidence 0.95)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="670" y="125" width="580" height="230" as="geometry" /></mxCell>
        <mxCell id="p3-5" value="&lt;b&gt;③ Thu thập song song&lt;/b&gt; — 5 call&lt;br&gt;order · order_items · shipment_summary · payment_timeline · policy&lt;br&gt;&lt;br&gt;Tổng cộng &lt;b&gt;6 call&lt;/b&gt; (kể cả history) — đúng ngân sách&lt;br&gt;Mỗi kết quả là 1 &lt;code&gt;evidence_ref&lt;/code&gt; do server cấp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1290" y="125" width="580" height="230" as="geometry" /></mxCell>
        <mxCell id="p3-6" value="&lt;b&gt;④ Conflict resolver — cùng 1 order_id nhưng có 2 lần mua: chọn lần nào?&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="1500" height="34" as="geometry" /></mxCell>
        <mxCell id="p3-7" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="588" width="1700" height="4" as="geometry" /></mxCell>
        <mxCell id="p3-8" value="Timeline 1 — &lt;b&gt;ĐƯỢC CHỌN&lt;/b&gt;: mua trước ngày mở case &amp;amp; đã quá hạn giao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;opacity=90;" vertex="1" parent="1"><mxGeometry x="240" y="450" width="740" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-9" value="Timeline 2 — &lt;b&gt;LOẠI&lt;/b&gt;: mua SAU ngày mở case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1520" y="450" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-10" value="" style="ellipse;html=1;aspect=fixed;fillColor=#82b366;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="241" y="581" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="p3-11" value="2017-12-29&lt;br&gt;&lt;b&gt;Mua lần 1&lt;/b&gt;&lt;br&gt;(delivered)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="608" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="p3-12" value="" style="ellipse;html=1;aspect=fixed;fillColor=#d79b00;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="551" y="581" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="p3-13" value="2018-01-08&lt;br&gt;&lt;b&gt;Hẹn giao&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="608" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="p3-14" value="" style="ellipse;html=1;aspect=fixed;fillColor=#b85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="951" y="581" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="p3-15" value="2018-01-12&lt;br&gt;&lt;b&gt;Giao thực tế&lt;/b&gt;&lt;br&gt;(trễ 4 ngày)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="608" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="p3-16" value="" style="ellipse;html=1;aspect=fixed;fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1521" y="581" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="p3-17" value="2018-05-02&lt;br&gt;&lt;b&gt;Mua lần 2&lt;/b&gt;&lt;br&gt;(canceled)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="608" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="p3-18" value="" style="rounded=0;html=1;fillColor=#b85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="757" y="545" width="6" height="135" as="geometry" /></mxCell>
        <mxCell id="p3-19" value="&lt;b&gt;2018-01-10&lt;br&gt;Case mở&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;fontColor=#b85450;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="498" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="p3-20" value="⋯ ~4 tháng ⋯" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;whiteSpace=wrap;labelBackgroundColor=#ffffff;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="570" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="p3-21" value="&lt;b&gt;Xung đột nguồn&lt;/b&gt;: get_order trả về lần mua 2 (canceled) ≠ timeline được chọn&lt;br&gt;⇒ ưu tiên customer history, ghi &lt;b&gt;4 data_conflicts&lt;/b&gt; (ngày mua, status, ngày giao, ngày hẹn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="770" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-22" value="Luật chọn: lần mua &lt;b&gt;gần nhất&lt;/b&gt; thoả (1) mua trước opened_at và (2) &lt;b&gt;đã tới hạn&lt;/b&gt; (quá ngày hẹn hoặc đã huỷ) — đơn chưa tới hạn thì chưa thể bị khiếu nại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="1010" height="70" as="geometry" /></mxCell>
        <mxCell id="p3-23" value="&lt;b&gt;⑤ Coordinator phân loại issue&lt;/b&gt;&lt;br&gt;Giao 01-12 &amp;gt; hẹn 01-08 ⇒ giao trễ&lt;br&gt;Seller bàn giao cho carrier sau shipping limit ⇒ &lt;b&gt;seller_delay&lt;/b&gt;&lt;br&gt;Không có refund / mismatch / capture lặp&lt;br&gt;⇒ issue &lt;b&gt;late_delivery_seller&lt;/b&gt;&lt;br&gt;Khớp claim chính ⇒ confidence &lt;b&gt;0.95&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="p3-24" value="&lt;b&gt;⑥ Policy agent — EC_POLICY_V2&lt;/b&gt;&lt;br&gt;status: &lt;b&gt;action_required&lt;/b&gt;&lt;br&gt;action: &lt;b&gt;refund_freight&lt;/b&gt; — hoàn &lt;b&gt;18.00 BRL&lt;/b&gt;&lt;br&gt;bên chịu trách nhiệm: seller của chính đơn này&lt;br&gt;claim-a (giao trễ do seller) → &lt;b&gt;supported&lt;/b&gt;&lt;br&gt;claim-b (đòi hoàn toàn bộ) → &lt;b&gt;partially_supported&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="670" y="790" width="580" height="250" as="geometry" /></mxCell>
        <mxCell id="p3-25" value="&lt;b&gt;⑦ Verifier — 9/9 kiểm tra đạt ✅&lt;/b&gt;&lt;br&gt;order thuộc lịch sử khách · evidence do chính case gọi&lt;br&gt;timeline mua trước opened_at · tổng tiền khớp&lt;br&gt;verdict khớp ngày giao · refund_lines = refund&lt;br&gt;seller chịu trách nhiệm thuộc đơn&lt;br&gt;⇒ ghi outputs/L3B_CASE_010.json + trace + report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1290" y="790" width="580" height="250" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4 · Độ tin cậy &amp; kết quả">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-1" value="Độ tin cậy, xử lý lỗi và kết quả" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1820" height="50" as="geometry" /></mxCell>
        <mxCell id="p4-2" value="Verifier kiểm tra lại độc lập từ raw evidence · lỗi mạng không làm phát sinh call trùng" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="1820" height="34" as="geometry" /></mxCell>
        <mxCell id="p4-3" value="&lt;b&gt;Verifier — 9 bất biến&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Order được resolve thuộc lịch sử khách&lt;br&gt;2. Candidate bị loại ∩ order được chọn = ∅&lt;br&gt;3. Mọi evidence_ref do chính case gọi&lt;br&gt;4. Timeline được chọn mua trước opened_at&lt;br&gt;5. Tổng payment rows = tổng capture events&lt;br&gt;6. Verdict giao hàng khớp ngày giao / ngày hẹn&lt;br&gt;7. Tổng refund_lines = refund đề xuất &lt;i&gt;(tự sửa)&lt;/i&gt;&lt;br&gt;8. no_action ⇒ refund = 0&lt;br&gt;9. Seller chịu trách nhiệm thuộc đơn&lt;br&gt;&lt;br&gt;⇒ &lt;code&gt;VERIFIED&lt;/code&gt; hoặc &lt;code&gt;VERIFIED_WITH_FIXES&lt;/code&gt;&lt;br&gt;⇒ sau đó CLI validate JSON Schema cho output + trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="590" height="580" as="geometry" /></mxCell>
        <mxCell id="p4-4" value="&lt;b&gt;Xử lý lỗi&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:14px&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Tình huống&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cách xử lý&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Timeout 1 call&lt;/td&gt;&lt;td&gt;retry 1 lần&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mất kết nối MCP&lt;/td&gt;&lt;td&gt;kết nối lại 3 lần (10/20/30 s), replay từ cache ⇒ không gọi trùng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tool báo “không có dữ liệu”&lt;/td&gt;&lt;td&gt;coi là không có, cache lại&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Không xác định được đơn&lt;/td&gt;&lt;td&gt;dùng claimed nếu hợp lệ, confidence ≤ 0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Nguồn mâu thuẫn&lt;/td&gt;&lt;td&gt;ưu tiên history / timeline, ghi data_conflicts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Policy không có rule&lt;/td&gt;&lt;td&gt;needs_investigation + escalate_manual_review&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#fdf1f0;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="590" height="580" as="geometry" /></mxCell>
        <mxCell id="p4-5" value="&lt;b&gt;Kết quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;100/100&lt;/b&gt; case có output + trace hợp lệ schema&lt;br&gt;• &lt;b&gt;600&lt;/b&gt; evidence — trung bình &lt;b&gt;6.00 call / case&lt;/b&gt;&lt;br&gt;• 10 loại issue × 10 case mỗi loại&lt;br&gt;• Điểm public: &lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;93.29&lt;/font&gt;&lt;/b&gt; (trần chung ≈ 93.9)&lt;br&gt;&lt;br&gt;&lt;b&gt;Hành trình tối ưu&lt;/b&gt;&lt;br&gt;v1 90.92 — bản đầu&lt;br&gt;v3 91.59 — cắt call thừa, efficiency chạm trần&lt;br&gt;v4 92.04 — chỉ trích dẫn evidence hỗ trợ kết luận&lt;br&gt;&lt;b&gt;v7 93.29&lt;/b&gt; — đơn huỷ ⇒ shipment verdict on_time&lt;br&gt;v8–v11 — thử thêm, không vượt v7 ⇒ giữ v7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1310" y="130" width="560" height="580" as="geometry" /></mxCell>
        <mxCell id="p4-6" value="&lt;b&gt;Hạn chế &amp;amp; hướng tiếp theo&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Kế hoạch viết cứng trong coordinator ⇒ thêm loại claim mới phải sửa code → có thể tách thành bảng cấu hình / plug-in&lt;br&gt;• Message A2A hiện dùng để ghi trace; dữ liệu đi qua context chung → có thể truyền dữ liệu thật bằng payload của message&lt;br&gt;• Không hiểu lời nhắn tự do (chủ đích, để chống prompt injection) → có thể thêm LLM chỉ để &lt;i&gt;giải thích&lt;/i&gt; kết quả, không để &lt;i&gt;quyết định&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=16;fillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="1820" height="280" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
