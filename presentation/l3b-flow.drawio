        <mxCell id="p2-21" value="&lt;b&gt;Shipment&lt;/b&gt;&lt;br&gt;get_shipment_summary&lt;br&gt;&lt;i&gt;chỉ khi claim giao hàng / unsupported&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="365" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-22" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br&gt;get_payment_timeline&lt;br&gt;(+ get_refund_timeline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="490" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-23" value="&lt;b&gt;Policy&lt;/b&gt;&lt;br&gt;get_policy&lt;br&gt;&lt;i&gt;tải rule trước&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="615" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-24" value="&lt;b&gt;Conflict resolver&lt;/b&gt;&lt;br&gt;tách các lần mua&lt;br&gt;chọn lần mua &lt;b&gt;đã tới hạn&lt;/b&gt; trước opened_at&lt;br&gt;ghi data_conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="180" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-25" value="&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;analyse_delivery&lt;br&gt;analyse_payment&lt;br&gt;classify_issue&lt;br&gt;(10 luật ưu tiên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="180" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-26" value="&lt;b&gt;VERIFY_DELAY&lt;/b&gt;&lt;br&gt;ra giao trễ nhưng chưa có evidence shipment ⇒ gọi thêm (tối đa 1 lần)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;arcSize=10;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="180" height="120" as="geometry" /></mxCell>
        <mxCell id="p2-27" value="&lt;b&gt;Policy agent&lt;/b&gt;&lt;br&gt;rule theo issue ⇒&lt;br&gt;status · action&lt;br&gt;refund · bên chịu TN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="400" width="170" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-28" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;9 bất biến&lt;br&gt;tự sửa&lt;br&gt;refund_lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1740" y="400" width="150" height="150" as="geometry" /></mxCell>
