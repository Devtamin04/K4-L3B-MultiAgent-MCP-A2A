        <mxCell id="p2-33" value="TIMELINE_&lt;br&gt;SELECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="p2-24" target="p2-25"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-34" value="DECIDE_&lt;br&gt;REMEDY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="p2-25" target="p2-27"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-35" value="REMEDY_&lt;br&gt;DECIDED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="p2-27" target="p2-28"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-36" value="READY_TO_FINALIZE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="p2-28" target="p2-29"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="p2-25" target="p2-26"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-38" value="gọi lại shipment-agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-26" target="p2-21"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-39" value="&lt;b&gt;Kế hoạch tool theo claim — đúng 6 call / case&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:13px&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Claim&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Tool gọi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;giao trễ / unsupported&lt;/td&gt;&lt;td&gt;history · order · items · &lt;b&gt;shipment&lt;/b&gt; · payment · policy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;đơn huỷ / không có hàng / thanh toán&lt;/td&gt;&lt;td&gt;history · order · items · &lt;b&gt;product&lt;/b&gt; · payment · policy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;refund pending / failed&lt;/td&gt;&lt;td&gt;history · order · items · payment · &lt;b&gt;refund&lt;/b&gt; · policy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;i&gt;Ngoại lệ: +1 call khi VERIFY_DELAY; −1 call khi case không có customer hint.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="230" as="geometry" /></mxCell>
        <mxCell id="p2-40" value="&lt;b&gt;Trace quan sát được (traces/trace.jsonl)&lt;/b&gt;&lt;br&gt;&lt;br&gt;case_received → task_assigned → tool_result_consumed → handoff → policy_decided → verification_completed → case_finalized&lt;br&gt;&lt;br&gt;• mỗi event được validate theo schema &lt;code&gt;trace-event-v1&lt;/code&gt;&lt;br&gt;• không ghi prompt / suy luận nội bộ — chỉ actor, target, intent, evidence_refs&lt;br&gt;• confidence: &lt;b&gt;0.95&lt;/b&gt; nếu evidence khớp claim, &lt;b&gt;0.65&lt;/b&gt; nếu evidence bác bỏ claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="890" height="230" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
