        <!-- Legend -->
        <mxCell id="legend" value="Actor có quyền gọi MCP tool riêng (least privilege) — xem bảng &quot;Agent ownership&quot; trong ARCHITECTURE.md.&#10;Mọi mũi tên đều tương ứng 1 trace event (task_assigned / handoff / tool_result_consumed / policy_decided / verification_completed)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
