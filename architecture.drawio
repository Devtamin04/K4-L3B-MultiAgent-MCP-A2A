<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="claude-code" version="24.0.0" type="device">
  <diagram id="l3b-architecture" name="L3B Multi-Agent Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Input -->
        <mxCell id="input" value="Case input&#10;(claimed_order_id, candidates,&#10;customer_unique_id_hint, claims)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Coordinator -->
        <mxCell id="coordinator" value="Coordinator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Entity agent -->
        <mxCell id="entity" value="Entity Agent&#10;(get_customer_history)&#10;resolve order, reject candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Specialist row -->
        <mxCell id="order" value="Order/Item Agent&#10;(get_order, get_order_items,&#10;get_product_context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="360" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="shipment" value="Shipment Agent&#10;(get_shipment_summary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="360" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="Payment/Refund Agent&#10;(get_payment_timeline,&#10;get_refund_timeline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="Policy Agent&#10;(get_policy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- MCP Gateway -->
        <mxCell id="mcp" value="MCP Gateway&#10;(audit theo team + case_id,&#10;trả evidence_ref có schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="240" y="480" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- Conflict resolver -->
        <mxCell id="conflict" value="Conflict Resolver&#10;tách timeline theo lần mua,&#10;chọn timeline đúng theo opened_at,&#10;ghi data_conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Coordinator decides -->
        <mxCell id="classify" value="Coordinator: phân tích shipment + payment&#10;→ suy ra primary_issue CHỈ từ evidence&#10;(không tin lời khai / claim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="580" y="720" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Policy decide -->
        <mxCell id="decide" value="Policy Agent: policy_decided&#10;→ case_status, action, refund_brl,&#10;responsible_parties" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="830" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Verifier -->
        <mxCell id="verifier" value="Verifier&#10;9 kiểm tra bất biến: entity scope,&#10;evidence ownership, refund sum,&#10;consistency, delivery vs dates..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="940" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="Output JSON (l3b-output-v2 schema)&#10;+ trace.jsonl (observable events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="1060" width="260" height="60" as="geometry" />
